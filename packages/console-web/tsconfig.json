{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "resolveJsonModule": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src", "mock", "scripts", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
