{
  "name": "@auto-router/console-web",
  "version": "0.0.0",
  "license": "MIT-0",
  "private": true,
  "type": "module",
  "description": "Admin console SPA (admin-console design v1 \u00a70.6): React + Vite + Cloudscape, Cognito managed login, en / zh-CN.",
  "exports": {
    "./runtime-config": {
      "types": "./src/config/runtime-config.ts",
      "default": "./src/config/runtime-config.ts"
    },
    "./security-headers": {
      "types": "./scripts/security-headers.ts",
      "default": "./scripts/security-headers.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "node scripts/dev-mock.ts",
    "mock": "node mock/server.ts",
    "build": "vite build && node scripts/licenses.ts && node scripts/build-info.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "config:local": "node scripts/write-local-config.ts",
    "e2e:deployed": "playwright test -c playwright.deployed.config.ts"
  },
  "dependencies": {
    "@auto-router/console-contract": "workspace:*",
    "@cloudscape-design/collection-hooks": "1.0.111",
    "@cloudscape-design/components": "3.0.1410",
    "@cloudscape-design/design-tokens": "3.0.117",
    "@cloudscape-design/global-styles": "1.0.72",
    "@tanstack/react-query": "5.107.1",
    "intl-messageformat": "10.7.18",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@auto-router/assessor": "workspace:*",
    "@auto-router/core": "workspace:*",
    "@auto-router/pricing": "workspace:*",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "vite": "8.3.6"
  }
}
