{
  "name": "@auto-router/assessor",
  "version": "0.0.0",
  "license": "MIT-0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "eval": "node src/eval/cli.ts",
    "smoke": "node src/eval/cli.ts smoke",
    "manifest": "node src/manifest-cli.ts"
  },
  "dependencies": {
    "@auto-router/core": "workspace:*",
    "@auto-router/pricing": "workspace:*"
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/credential-provider-node": "3.972.92",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.5"
  }
}
