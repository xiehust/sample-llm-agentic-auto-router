#!/usr/bin/env python3
"""llmar: sign in to an llm-auto-router deployment with your own account, and print router access tokens.

  llmar configure --from '<json>' | @file | -     store this deployment's settings (no secrets)
  llmar login [--no-browser] [--port N]            browser sign-in (authorization code + PKCE, loopback redirect)
  llmar token [--json]                             print a cached access token, refreshing it when needed
  llmar headers                                    print request header lines (for `curl -H @<(llmar headers)`)
  llmar status                                     who is signed in, until when (no network, no token values)
  llmar logout                                     revoke the refresh token and delete the local credentials

`llmar-token` and `llmar-login` (symlinks to this file) are `llmar token` and `llmar login`, so tools can run
them with no arguments: Claude Code `apiKeyHelper`, Codex `[model_providers.<id>.auth] command`.

Every subcommand takes --profile (or LLMAR_PROFILE; default "default"). Files live in $LLMAR_CONFIG_DIR, else
$XDG_CONFIG_HOME/llmar, else ~/.config/llmar: config.json (settings) and credentials-<profile>.json (0600: the
refresh token and the cached access token). Python 3.9+, standard library only.

`llmar token` prints the token and a newline, or nothing; every message goes to stderr. It never opens a browser
and never reads stdin. Exit codes: 0 token printed; 2 sign-in required (not signed in, the refresh was refused,
or the settings changed since sign-in): run `llmar login`; 3 identity provider unreachable and no usable cached
token; 4 bad settings, unsafe file permissions or bad usage.
"""
from __future__ import annotations

import argparse
import base64
import hashlib
import hmac
import http.server
import json
import os
import re
import secrets
import stat
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser
from typing import Any, Dict, List, NoReturn, Optional

try:
    import fcntl
except ImportError:  # Windows
    fcntl = None  # type: ignore[assignment]
    import msvcrt

VERSION = '0.1.0'
EXIT_OK, EXIT_LOGIN, EXIT_IDP, EXIT_CONFIG = 0, 2, 3, 4
MARGIN_S = 300            # refresh this long before expiry; client caches (Claude Code TTL, Codex interval) are 240 s
HTTP_TIMEOUT_S = 10       # under Codex's auth timeout_ms (15 000 in the docs)
LOGIN_TIMEOUT_S = 300
SCHEMA = 1
LOOPBACK = ('127.0.0.1', '::1', 'localhost')
PROFILE_RE = re.compile(r'^[A-Za-z0-9_-]{1,64}$')
CLIENT_ID_RE = re.compile(r'^[\w+]{1,128}$')
HEADER_RE = re.compile(r'^[A-Za-z0-9-]{1,64}$')
SCOPE_RE = re.compile(r'^[\x21\x23-\x5B\x5D-\x7E]+$')   # Cognito's scope pattern
# Settings in config.json, per profile. Endpoints default from cognitoDomain (/oauth2/authorize|token|revoke).
KEYS = ('cognitoDomain', 'authorizeEndpoint', 'tokenEndpoint', 'revokeEndpoint', 'clientId', 'scope',
        'redirectPorts', 'gatewayUrl', 'identityHeader', 'refreshDays')
IGNORED_KEYS = ('schemaVersion', 'profile', 'codexOauthPort', 'region')   # in the console block, not used here
LOGIN_ERRORS = ('invalid_grant', 'unauthorized_client', 'invalid_client', 'invalid_request', 'invalid_scope')


class CliError(Exception):
    def __init__(self, code: int, message: str):
        super().__init__(message)
        self.code = code


def say(msg: str) -> None:
    print(f'llmar: {msg}', file=sys.stderr)


# ---------------------------------------------------------------- paths and files

def config_dir() -> str:
    if os.environ.get('LLMAR_CONFIG_DIR'):
        return os.environ['LLMAR_CONFIG_DIR']
    base = os.environ.get('XDG_CONFIG_HOME') or os.path.join(os.path.expanduser('~'), '.config')
    return os.path.join(base, 'llmar')


def private_group(st: os.stat_result) -> bool:
    """True when the file's group is the caller's own private group (user private groups: Debian/Ubuntu's default
    umask 002 makes ~/.config 0775): owned by the caller, group = the caller's primary group, named like the caller,
    with no other members. Nobody else can write through such a group (the rule of Debian's OpenSSH StrictModes)."""
    if os.name != 'posix' or st.st_uid != os.getuid() or st.st_gid != os.getgid():
        return False
    try:
        import grp
        import pwd
        user = pwd.getpwuid(os.getuid()).pw_name
        group = grp.getgrgid(st.st_gid)
    except (ImportError, KeyError):
        return False
    return group.gr_name == user and all(m == user for m in group.gr_mem)


def others_can_write(st: os.stat_result) -> bool:
    """Someone other than the caller can create or replace entries: world-writable, or group-writable through a
    group that is not the caller's private group; the sticky bit (like /tmp) protects entries either way."""
    if st.st_mode & stat.S_ISVTX:
        return False
    return bool(st.st_mode & 0o002) or bool(st.st_mode & 0o020 and not private_group(st))


def ensure_dir(path: str) -> None:
    """The directory holds the credentials: ours, and not writable by anyone else. Its parent must not let others
    replace it either: not writable by others unless sticky (like /tmp); group write through the caller's private
    group is fine. Windows: best effort, ACLs not checked."""
    if os.name == 'posix':
        parent = os.path.dirname(os.path.abspath(path))
        pst = os.stat(parent) if os.path.isdir(parent) else None
        if pst and others_can_write(pst):
            raise CliError(EXIT_CONFIG, f'{parent} is writable by others without the sticky bit: others could replace '
                                        f'the llmar directory; run `chmod go-w {parent}` or use another LLMAR_CONFIG_DIR')
    if not os.path.isdir(path):
        os.makedirs(path, mode=0o700, exist_ok=True)
        if os.name == 'posix':
            os.chmod(path, 0o700)
    if os.name == 'posix':
        st = os.lstat(path)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o022:
            raise CliError(EXIT_CONFIG, f'{path} must be a directory owned by you and not group/world-writable '
                                        f'(chmod 700 {path})')
        if st.st_mode & 0o077:
            os.chmod(path, 0o700)  # only read/search bits were open: tighten, the directory is llmar's own


def write_private(path: str, data: Dict[str, Any]) -> None:
    """Atomic write, mode 0600 from creation (umask can only remove bits)."""
    ensure_dir(os.path.dirname(path))
    tmp = f'{path}.tmp-{secrets.token_hex(6)}'
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, 'w') as f:
            json.dump(data, f, indent=1, sort_keys=True)
            f.write('\n')
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def read_private(path: str, secret: bool = True) -> Optional[Dict[str, Any]]:
    """None if absent. Refuses a file that is not ours, that others can write, or (secret) that others can read."""
    flags = os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0)
    try:
        fd = os.open(path, flags)
    except FileNotFoundError:
        return None
    except OSError as e:
        raise CliError(EXIT_CONFIG, f'cannot open {path}: {e.strerror}') from None
    with os.fdopen(fd) as f:
        if os.name == 'posix':
            st = os.fstat(f.fileno())
            if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & (0o077 if secret else 0o022):
                raise CliError(EXIT_CONFIG, f'{path} must be a file owned by you with mode 0600 (chmod 600 {path})')
        try:
            data = json.load(f)
        except ValueError:
            raise CliError(EXIT_CONFIG, f'{path} is not valid JSON') from None
    if not isinstance(data, dict):
        raise CliError(EXIT_CONFIG, f'{path} is not a JSON object')
    return data


class Lock:
    """Advisory lock next to the credentials: shared to read, exclusive to refresh or write."""

    def __init__(self, path: str, exclusive: bool):
        self.path, self.exclusive, self.fd = path, exclusive, -1

    def __enter__(self) -> 'Lock':
        ensure_dir(os.path.dirname(self.path))
        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT | getattr(os, 'O_NOFOLLOW', 0), 0o600)
        if fcntl is not None:
            fcntl.flock(self.fd, fcntl.LOCK_EX if self.exclusive else fcntl.LOCK_SH)
        else:
            msvcrt.locking(self.fd, msvcrt.LK_LOCK, 1)  # exclusive only on Windows
        return self

    def __exit__(self, *exc: object) -> None:
        if fcntl is None:
            os.lseek(self.fd, 0, os.SEEK_SET)
            msvcrt.locking(self.fd, msvcrt.LK_UNLCK, 1)
        os.close(self.fd)  # releases the flock


# ---------------------------------------------------------------- settings

def endpoint(url: Any, name: str) -> str:
    """HTTPS, or HTTP to a loopback host only; no credentials, query or fragment in the URL."""
    if not isinstance(url, str) or not url:
        raise CliError(EXIT_CONFIG, f'{name}: missing')
    u = urllib.parse.urlsplit(url)
    host = (u.hostname or '').lower()
    if u.scheme not in ('https', 'http') or not host or u.username or u.password or u.query or u.fragment:
        raise CliError(EXIT_CONFIG, f'{name}: not an https URL without credentials, query or fragment')
    if u.scheme == 'http' and host not in LOOPBACK:
        raise CliError(EXIT_CONFIG, f'{name}: plain http is allowed only for a loopback host')
    return url.rstrip('/')


def validate_settings(raw: Dict[str, Any], warn: bool = False) -> Dict[str, Any]:
    unknown = sorted(set(raw) - set(KEYS) - set(IGNORED_KEYS))
    if unknown and warn:
        say(f'ignoring unknown setting(s): {", ".join(unknown)}')
    s: Dict[str, Any] = {}
    domain = endpoint(raw['cognitoDomain'], 'cognitoDomain') if raw.get('cognitoDomain') else None
    for key, path in (('authorizeEndpoint', '/oauth2/authorize'), ('tokenEndpoint', '/oauth2/token'),
                      ('revokeEndpoint', '/oauth2/revoke')):
        if raw.get(key):
            s[key] = endpoint(raw[key], key)
        elif domain:
            s[key] = domain + path
        else:
            raise CliError(EXIT_CONFIG, f'{key}: missing (give cognitoDomain or {key})')
    if not isinstance(raw.get('clientId'), str) or not CLIENT_ID_RE.match(raw['clientId']):
        raise CliError(EXIT_CONFIG, 'clientId: missing or not a client id')
    s['clientId'] = raw['clientId']
    scope = raw.get('scope')
    if not isinstance(scope, str) or not scope.split() or any(not SCOPE_RE.match(x) for x in scope.split()):
        raise CliError(EXIT_CONFIG, 'scope: missing or invalid (e.g. "llmar/invoke")')
    s['scope'] = ' '.join(x for x in scope.split() if x != 'openid')
    if not s['scope']:
        raise CliError(EXIT_CONFIG, 'scope: needs the router scope, not only openid')
    ports = raw.get('redirectPorts')
    if (not isinstance(ports, list) or not 1 <= len(ports) <= 10
            or any(not isinstance(p, int) or isinstance(p, bool) or not 1024 <= p <= 65535 for p in ports)):
        raise CliError(EXIT_CONFIG, 'redirectPorts: 1 to 10 port numbers (1024-65535), as registered on the app client')
    s['redirectPorts'] = list(dict.fromkeys(ports))
    if raw.get('gatewayUrl') is not None:
        s['gatewayUrl'] = endpoint(raw['gatewayUrl'], 'gatewayUrl')
    ih = raw.get('identityHeader', 'x-api-key')
    if ih in (None, ''):
        s['identityHeader'] = None
    elif isinstance(ih, str) and HEADER_RE.match(ih) and ih.lower() not in ('authorization', 'cookie', 'host'):
        s['identityHeader'] = ih.lower()
    else:
        raise CliError(EXIT_CONFIG, 'identityHeader: a header name such as "x-api-key", or null for none')
    rd = raw.get('refreshDays')
    if rd is not None:
        if not isinstance(rd, int) or isinstance(rd, bool) or not 1 <= rd <= 3650:
            raise CliError(EXIT_CONFIG, 'refreshDays: 1 to 3650')
        s['refreshDays'] = rd
    return s


def config_path() -> str:
    return os.path.join(config_dir(), 'config.json')


def load_settings(profile: str) -> Dict[str, Any]:
    cfg = read_private(config_path(), secret=False)
    prof = (cfg or {}).get('profiles', {}).get(profile)
    if not isinstance(prof, dict):
        raise CliError(EXIT_CONFIG, f'profile "{profile}" is not configured: '
                                "run llmar configure --from '<json>' (Get started page)")
    return validate_settings(prof)


def creds_path(profile: str) -> str:
    return os.path.join(config_dir(), f'credentials-{profile}.json')


def lock_path(profile: str) -> str:
    return os.path.join(config_dir(), f'credentials-{profile}.lock')


# ---------------------------------------------------------------- tokens and HTTP

def b64url(b: bytes) -> str:
    return base64.urlsafe_b64encode(b).rstrip(b'=').decode()


def pkce_challenge(verifier: str) -> str:
    return b64url(hashlib.sha256(verifier.encode('ascii')).digest())


def jwt_claims(token: str) -> Dict[str, Any]:
    """Payload of a JWT, NOT verified: display and the nonce check only. The token came straight from the token
    endpoint over TLS (OIDC Core 3.1.3.7); the gateway and the router verify signatures."""
    try:
        payload = token.split('.')[1]
        data = json.loads(base64.urlsafe_b64decode(payload + '=' * (-len(payload) % 4)))
    except (IndexError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def check_access_claims(claims: Dict[str, Any], s: Dict[str, Any]) -> None:
    """Before storing a sign-in: the access token is for this client and carries every configured scope, so a
    misconfigured app client fails here, not later at the gateway (claims decoded unverified, as above)."""
    if claims.get('token_use') != 'access':
        raise CliError(EXIT_LOGIN, 'sign-in failed: the token endpoint did not return an access token')
    if claims.get('client_id') != s['clientId']:
        raise CliError(EXIT_LOGIN, 'sign-in failed: the access token is for another app client')
    granted = set(str(claims.get('scope', '')).split())
    missing = [x for x in s['scope'].split() if x not in granted]
    if missing:
        raise CliError(EXIT_LOGIN, f'sign-in failed: this app client does not grant {" ".join(missing)} '
                                   '(ask your admin to allow the scope on the cli app client)')


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args: Any, **kwargs: Any) -> None:
        return None  # a token endpoint never redirects; never re-send a grant elsewhere


_opener = urllib.request.build_opener(_NoRedirect)


def post_form(url: str, form: Dict[str, str]) -> Dict[str, Any]:
    """POST to the token or revoke endpoint. Returns the JSON body ({} if empty). Raises CliError(EXIT_LOGIN) for a
    4xx OAuth error (code in the message, never the description) and CliError(EXIT_IDP) for network/5xx/429."""
    data = urllib.parse.urlencode(form).encode()
    req = urllib.request.Request(url, data=data, method='POST', headers={  # nosec B310  # noqa: S310
        'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json',
        'User-Agent': f'llmar/{VERSION}'})
    try:
        # endpoint() allows only https, or http to a loopback host
        with _opener.open(req, timeout=HTTP_TIMEOUT_S) as r:  # nosec B310  # noqa: S310
            body = r.read(1 << 20)
    except urllib.error.HTTPError as e:
        code = e.code
        try:
            err = json.loads(e.read(1 << 16) or b'{}').get('error')
        except (ValueError, AttributeError):
            err = None
        err = err if isinstance(err, str) and re.match(r'^[a-z_]{1,40}$', err) else None
        if 400 <= code < 500 and code != 429:
            where = urllib.parse.urlsplit(url).path
            raise CliError(EXIT_LOGIN, f'{where} refused: HTTP {code} {err or ""}'.rstrip()) from None
        raise CliError(EXIT_IDP, f'identity provider error: HTTP {code}') from None
    except (urllib.error.URLError, OSError) as e:
        reason = getattr(e, 'reason', e)
        raise CliError(EXIT_IDP, f'identity provider unreachable: {type(reason).__name__}') from None
    if not body.strip():
        return {}
    try:
        data = json.loads(body)
    except ValueError:
        raise CliError(EXIT_IDP, 'identity provider returned a non-JSON body') from None
    if not isinstance(data, dict):
        raise CliError(EXIT_IDP, 'identity provider returned a non-object body')
    return data


def token_fields(resp: Dict[str, Any], need_refresh: bool) -> Dict[str, Any]:
    at, exp = resp.get('access_token'), resp.get('expires_in')
    if (not isinstance(at, str) or not at or str(resp.get('token_type', 'Bearer')).lower() != 'bearer'
            or not isinstance(exp, (int, float)) or isinstance(exp, bool) or exp <= 0):
        raise CliError(EXIT_IDP, 'token response without a usable bearer access token')
    rt = resp.get('refresh_token')
    if need_refresh and (not isinstance(rt, str) or not rt):
        raise CliError(EXIT_LOGIN, 'no refresh token in the response: the app client must allow the code grant '
                               'with refresh tokens')
    now = time.time()
    out = {'accessToken': at, 'obtainedAt': now, 'expiresAt': now + float(exp)}
    if isinstance(rt, str) and rt:
        out['refreshToken'] = rt
    return out


def margin(c: Dict[str, Any]) -> float:
    life = float(c['expiresAt']) - float(c.get('obtainedAt', c['expiresAt']))
    return min(MARGIN_S, max(life / 2, 0.0))  # short-lived tokens (tests, odd pools): refresh at half-life


def fresh(c: Optional[Dict[str, Any]], now: float) -> bool:
    return bool(c and c.get('accessToken') and float(c.get('expiresAt', 0)) - now > margin(c))


def bound_to(c: Dict[str, Any], s: Dict[str, Any]) -> bool:
    """Credentials only go back to the endpoint and client they came from."""
    return c.get('tokenEndpoint') == s['tokenEndpoint'] and c.get('clientId') == s['clientId']


def get_token(profile: str) -> Dict[str, Any]:
    s = load_settings(profile)
    path = creds_path(profile)
    with Lock(lock_path(profile), exclusive=False):
        c = read_private(path)
    if c and c.get('accessToken') and not bound_to(c, s):
        raise CliError(EXIT_LOGIN, 'the settings changed since sign-in: run llmar login')
    if fresh(c, time.time()):
        return c  # type: ignore[return-value]
    with Lock(lock_path(profile), exclusive=True):
        c = read_private(path)  # another process may have refreshed while we waited
        if not c or not c.get('refreshToken'):
            raise CliError(EXIT_LOGIN, 'not signed in: run llmar login')
        if not bound_to(c, s):
            raise CliError(EXIT_LOGIN, 'the settings changed since sign-in: run llmar login')
        if fresh(c, time.time()):
            return c
        try:
            resp = post_form(c['tokenEndpoint'], {'grant_type': 'refresh_token', 'client_id': c['clientId'],
                                                  'refresh_token': c['refreshToken']})
        except CliError as e:
            if e.code == EXIT_LOGIN:
                if 'invalid_grant' in str(e):
                    for k in ('accessToken', 'refreshToken', 'expiresAt'):
                        c.pop(k, None)
                    c['revokedAt'] = time.time()
                    write_private(path, c)
                raise CliError(EXIT_LOGIN, f'{e}. Your sign-in expired or was revoked: run llmar login (if this '
                                       'keeps failing, your account may be disabled; contact your admin)') from None
            if c.get('accessToken') and float(c.get('expiresAt', 0)) - time.time() > 30:
                say(f'{e}; using the cached token (valid {int(float(c["expiresAt"]) - time.time())} s more)')
                return c
            raise
        c.update(token_fields(resp, need_refresh=False))  # no refresh_token in the reply: rotation is off, keep ours
        c['refreshCount'] = int(c.get('refreshCount', 0)) + 1
        write_private(path, c)
        return c


# ---------------------------------------------------------------- login

PAGE = ('<!doctype html><meta charset="utf-8"><title>llmar</title><body style="font-family:sans-serif;margin:3em">'
        '<p>{en}</p><p>{zh}</p></body>')
DONE = PAGE.format(en='Signed in. You can close this tab.', zh='已登录，可以关闭此页。').encode()
FAILED = PAGE.format(en='Sign-in did not complete. Return to the terminal.', zh='登录未完成，请回到终端查看。').encode()
STALE = PAGE.format(en='This sign-in link is not the current one. Return to the terminal.',
                    zh='此登录链接不是当前的登录请求，请回到终端。').encode()


class _Callback(http.server.BaseHTTPRequestHandler):
    server: '_CallbackServer'
    timeout = 5  # socket timeout: a connection that sends nothing cannot hold the single-threaded listener

    def log_message(self, *args: Any) -> None:
        pass  # never log: the query string carries the authorization code

    def _reply(self, code: int, body: bytes) -> None:
        self.send_response(code)
        for k, v in (('Content-Type', 'text/html; charset=utf-8'), ('Content-Length', str(len(body))),
                     ('Cache-Control', 'no-store'), ('Referrer-Policy', 'no-referrer'),
                     ('X-Content-Type-Options', 'nosniff'), ('Connection', 'close')):
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:  # noqa: N802 (http.server API)
        u = urllib.parse.urlsplit(self.path)
        if u.path != '/callback':
            return self._reply(404, b'')
        q = dict(urllib.parse.parse_qsl(u.query, keep_blank_values=True))
        if not hmac.compare_digest(q.get('state', '').encode(), self.server.state.encode()):
            return self._reply(400, STALE)  # not our request (stale tab or forged): keep waiting
        if q.get('error'):
            err = q['error'] if re.match(r'^[a-z_]{1,40}$', q['error']) else 'error'
            self.server.result = {'error': err}
            return self._reply(400, FAILED)
        if not q.get('code'):
            self.server.result = {'error': 'no_code'}
            return self._reply(400, FAILED)
        self.server.result = {'code': q['code']}
        self._reply(200, DONE)

    def do_POST(self) -> None:  # noqa: N802
        self._reply(405, b'')


class _CallbackServer(http.server.HTTPServer):
    allow_reuse_address = False
    state = ''
    result: Optional[Dict[str, str]] = None


def bind_callback(ports: List[int]) -> _CallbackServer:
    for p in ports:
        try:
            return _CallbackServer(('127.0.0.1', p), _Callback)  # loopback only (RFC 8252 §7.3, §8.3)
        except OSError:
            continue
    listed = ', '.join(map(str, ports))
    raise CliError(EXIT_CONFIG, f'callback ports {listed} on 127.0.0.1 are all in use; free one and retry')


def login(profile: str, no_browser: bool, port: Optional[int], timeout: float) -> None:
    s = load_settings(profile)
    ports = s['redirectPorts']
    if port is not None:
        if port not in ports:
            raise CliError(EXIT_CONFIG, f'--port {port} is not one of the registered ports {ports}')
        ports = [port]
    verifier = secrets.token_urlsafe(64)
    state, nonce = secrets.token_urlsafe(32), secrets.token_urlsafe(32)
    srv = bind_callback(ports)
    try:
        srv.state = state
        redirect_uri = f'http://127.0.0.1:{srv.server_address[1]}/callback'
        url = s['authorizeEndpoint'] + '?' + urllib.parse.urlencode({
            'response_type': 'code', 'client_id': s['clientId'], 'redirect_uri': redirect_uri,
            'scope': f'openid {s["scope"]}', 'state': state, 'nonce': nonce,
            'code_challenge': pkce_challenge(verifier), 'code_challenge_method': 'S256'})
        port_used = srv.server_address[1]
        print(f'Open this URL to sign in:\n\n  {url}\n', file=sys.stderr)
        print(f'Over SSH, forward the port first from your own machine: '
              f'ssh -L {port_used}:127.0.0.1:{port_used} <host>', file=sys.stderr)
        if not no_browser:
            try:
                webbrowser.open(url)
            except Exception:  # noqa: BLE001, S110 - a browser is a convenience; the URL is printed above
                pass
        print(f'Waiting for the sign-in to finish (up to {int(timeout)} s) ...', file=sys.stderr, flush=True)
        deadline = time.monotonic() + timeout
        while srv.result is None:
            left = deadline - time.monotonic()
            if left <= 0:
                raise CliError(EXIT_LOGIN, 'sign-in timed out')
            srv.timeout = min(left, 1.0)
            srv.handle_request()
        result = srv.result
    finally:
        srv.server_close()
    if 'error' in result:
        raise CliError(EXIT_LOGIN, f'sign-in failed: {result["error"]}')
    resp = post_form(s['tokenEndpoint'], {'grant_type': 'authorization_code', 'client_id': s['clientId'],
                                          'code': result['code'], 'redirect_uri': redirect_uri,
                                          'code_verifier': verifier})
    tok = token_fields(resp, need_refresh=True)
    idc = jwt_claims(resp.get('id_token') or '')
    if not idc or not hmac.compare_digest(str(idc.get('nonce', '')).encode(), nonce.encode()):
        raise CliError(EXIT_LOGIN, 'sign-in failed: the ID token is missing or its nonce does not match')
    aud = idc.get('aud')
    if s['clientId'] not in (aud if isinstance(aud, list) else [aud]):
        raise CliError(EXIT_LOGIN, 'sign-in failed: the ID token is for another client')
    atc = jwt_claims(tok['accessToken'])
    check_access_claims(atc, s)
    groups = atc.get('cognito:groups')
    c = {'schemaVersion': SCHEMA, 'profile': profile, 'tokenEndpoint': s['tokenEndpoint'],
         'revokeEndpoint': s['revokeEndpoint'], 'clientId': s['clientId'], 'signedInAt': tok['obtainedAt'],
         'sub': str(idc.get('sub', '')), 'username': str(idc.get('cognito:username') or idc.get('username') or ''),
         'groups': [g for g in groups if isinstance(g, str)] if isinstance(groups, list) else [], **tok}
    with Lock(lock_path(profile), exclusive=True):
        write_private(creds_path(profile), c)
    until = time.strftime('%H:%M', time.localtime(c['expiresAt']))
    print(f'Signed in as {c["username"] or c["sub"]} (profile {profile}). Access token valid until {until}; '
          'llmar token refreshes it.', file=sys.stderr)


# ---------------------------------------------------------------- other subcommands

def configure(profile: str, source: Optional[str], show: bool) -> None:
    path = config_path()
    cfg = read_private(path, secret=False) or {'schemaVersion': SCHEMA, 'profiles': {}}
    if show:
        prof = cfg.get('profiles', {}).get(profile)
        if prof is None:
            raise CliError(EXIT_CONFIG, f'profile "{profile}" is not configured')
        print(json.dumps(validate_settings(prof), indent=1, sort_keys=True))
        return
    if source is None:
        raise CliError(EXIT_CONFIG, "give --from '<json>', --from @file or --from - "
                                    '(the block from the Get started page)')
    if source == '-':
        text = sys.stdin.read()
    elif source.startswith('@'):
        try:
            with open(source[1:]) as f:
                text = f.read()
        except OSError as e:
            raise CliError(EXIT_CONFIG, f'cannot read {source[1:]}: {e.strerror}') from None
    else:
        text = source
    try:
        raw = json.loads(text)
    except ValueError:
        raise CliError(EXIT_CONFIG, 'the settings are not valid JSON') from None
    if not isinstance(raw, dict):
        raise CliError(EXIT_CONFIG, 'the settings must be a JSON object')
    s = validate_settings(raw, warn=True)
    cfg.setdefault('profiles', {})[profile] = s
    cfg['schemaVersion'] = SCHEMA
    write_private(path, cfg)
    c = read_private(creds_path(profile))
    note = ' Run llmar login.' if not c or not bound_to(c, s) else ''
    print(f'Saved profile {profile} in {path}.{note}', file=sys.stderr)


def status(profile: str) -> int:
    s = load_settings(profile)
    c = read_private(creds_path(profile))
    out = [f'profile:   {profile}']
    if s.get('gatewayUrl'):
        out.append(f'gateway:   {s["gatewayUrl"]}')
    rc = EXIT_OK
    if not c or not c.get('refreshToken'):
        why = ' (the last refresh was refused)' if c and c.get('revokedAt') else ''
        out.append(f'signed in: no{why}: run llmar login')
        rc = EXIT_LOGIN
    elif not bound_to(c, s):
        out.append('signed in: for other settings: run llmar login')
        rc = EXIT_LOGIN
    else:
        fmt = '%Y-%m-%d %H:%M'
        out.append(f'signed in: {c.get("username") or c.get("sub")} (sub {c.get("sub")})')
        if c.get('groups'):
            out.append(f'groups:    {", ".join(c["groups"])}')
        out.append(f'since:     {time.strftime(fmt, time.localtime(c["signedInAt"]))}')
        if s.get('refreshDays'):
            by = time.localtime(c['signedInAt'] + 86400 * s['refreshDays'])
            out.append(f'sign in again by about {time.strftime(fmt, by)}')
        left = float(c.get('expiresAt', 0)) - time.time()
        state = f'valid {int(left // 60)} min more' if left > 0 else 'expired (refreshed on next use)'
        out.append(f'token:     cached, {state}')
    out.append(f'header:    authorization{", " + s["identityHeader"] if s.get("identityHeader") else ""}')
    print('\n'.join(out))
    return rc


def logout(profile: str) -> int:
    path = creds_path(profile)
    with Lock(lock_path(profile), exclusive=True):
        c = read_private(path)
        if not c:
            say('not signed in')
            return EXIT_OK
        rc = EXIT_OK
        if c.get('refreshToken') and c.get('revokeEndpoint'):
            try:
                post_form(c['revokeEndpoint'], {'token': c['refreshToken'], 'client_id': c['clientId']})
            except CliError as e:
                say(f'{e}: the refresh token could not be revoked and stays valid until it expires')
                rc = EXIT_IDP
        os.unlink(path)
    say(f'signed out (profile {profile})')
    return rc


# ---------------------------------------------------------------- CLI

class _Parser(argparse.ArgumentParser):
    def error(self, message: str) -> NoReturn:
        self.print_usage(sys.stderr)
        say(message)
        sys.exit(EXIT_CONFIG)  # never 2: tools read exit 2 as "sign in again"


def parser() -> argparse.ArgumentParser:
    ap = _Parser(prog='llmar', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--version', action='version', version=f'llmar {VERSION}')
    sub = ap.add_subparsers(dest='cmd', required=True, parser_class=_Parser)

    def cmd(name: str, help_: str) -> argparse.ArgumentParser:
        p = sub.add_parser(name, help=help_)
        p.add_argument('--profile', default=os.environ.get('LLMAR_PROFILE', 'default'))
        return p

    p = cmd('configure', "store this deployment's settings (JSON from the Get started page)")
    p.add_argument('--from', dest='source', metavar='JSON|@FILE|-')
    p.add_argument('--show', action='store_true', help='print the stored settings')
    p = cmd('login', 'sign in in the browser')
    p.add_argument('--no-browser', action='store_true', help='only print the URL (SSH, headless)')
    p.add_argument('--port', type=int, help='one of the registered callback ports')
    p.add_argument('--timeout', type=float, default=LOGIN_TIMEOUT_S, help=argparse.SUPPRESS)
    p = cmd('token', 'print an access token (cached, refreshed when needed)')
    p.add_argument('--json', action='store_true', help='print {"access_token", "expires_at"}')
    cmd('headers', 'print "authorization: Bearer …" and the identity header line')
    cmd('status', 'show the sign-in state (no token values)')
    cmd('logout', 'revoke the refresh token and delete the local credentials')
    return ap


def main(argv: Optional[List[str]] = None) -> int:
    if argv is None:
        name = os.path.basename(sys.argv[0])
        name = name[:-3] if name.endswith('.py') else name
        argv = sys.argv[1:]
        alias = {'llmar-token': 'token', 'llmar-login': 'login'}.get(name)
        if alias:
            argv = [alias] + argv
    args = parser().parse_args(argv)
    if not PROFILE_RE.match(args.profile):
        say('--profile: letters, digits, "_" and "-" only')
        return EXIT_CONFIG
    try:
        if args.cmd == 'token':
            c = get_token(args.profile)
            if args.json:
                j = {'access_token': c['accessToken'], 'expires_at': int(c['expiresAt'])}
                sys.stdout.write(json.dumps(j) + '\n')
            else:
                sys.stdout.write(c['accessToken'] + '\n')
            return EXIT_OK
        if args.cmd == 'headers':
            s = load_settings(args.profile)
            c = get_token(args.profile)
            lines = [f'authorization: Bearer {c["accessToken"]}']
            if s.get('identityHeader'):
                lines.append(f'{s["identityHeader"]}: {c["accessToken"]}')
            sys.stdout.write('\n'.join(lines) + '\n')
            return EXIT_OK
        if args.cmd == 'login':
            login(args.profile, args.no_browser, args.port, args.timeout)
            return EXIT_OK
        if args.cmd == 'configure':
            configure(args.profile, args.source, args.show)
            return EXIT_OK
        if args.cmd == 'status':
            return status(args.profile)
        if args.cmd == 'logout':
            return logout(args.profile)
    except CliError as e:
        say(str(e))
        return e.code
    except KeyboardInterrupt:
        say('interrupted')
        return 130
    return EXIT_CONFIG


if __name__ == '__main__':
    sys.exit(main())
