# Copy to scripts/local.env (gitignored) and fill in. Never commit the filled-in file.
# The live scripts (spikes, e2e, eval, fixture capture) refuse to call AWS unless the caller's account equals
# LLMAR_SPIKE_ACCOUNT, and they never print or write it.
export LLMAR_SPIKE_ACCOUNT=<account-id>
export AWS_REGION=<aws-region>
# Optional: adds an Owner tag to the resources the scripts create.
# export LLMAR_OWNER=<team-or-alias>
# Optional, spikes/apigw-hop only: the Region for the V9d spike (default ap-northeast-1).
# export LLMAR_SPIKE_REGION=<aws-region>
